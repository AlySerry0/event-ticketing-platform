{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Error Rate — ticket-service (LogQL)",
      "description": "Count of ERROR-level log lines per minute. A spike means something is broken in ticket-service.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({service=\"ticket-service\"} | json | level=\"ERROR\" [1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Feign Call Outcomes — ticket-service (LogQL)",
      "description": "Detects when booking-service or event-service is degraded — rising FeignException count means a downstream is failing.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "count_over_time({service=\"ticket-service\"} | json | logger=~\".*Client.*\" | level=\"WARN\" [1m])",
          "legendFormat": "feign-warn/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Rate — ticket-service (PromQL)",
      "description": "Requests per second to each ticket-service endpoint. Identifies high-traffic endpoints under load.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"ticket-service\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP P99 Latency — ticket-service (PromQL)",
      "description": "99th-percentile request duration per endpoint. High P99 on scan history means Cassandra is slow.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"ticket-service\"}[5m])))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "RabbitMQ Event Audit — ticket-service (LogQL)",
      "description": "Tracks ticket events published and consumed — ticket.issued published, booking.placed and booking.cancelled consumed.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (routingKey) (count_over_time({service=\"ticket-service\"} | json | routingKey != \"\" [5m]))",
          "legendFormat": "{{routingKey}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Heap Used — ticket-service (PromQL)",
      "description": "Heap memory usage over time. Rising heap after Cassandra scan events indicates a memory pressure issue.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"ticket-service\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 7,
      "title": "Correlation ID Trace — ticket-service (LogQL)",
      "description": "Trace a single request across all ticket-service log lines by correlationId.",
      "type": "logs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"ticket-service\"} | json | correlationId=\"$correlationId\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["eventticketing", "ticket-service", "m3"],
  "templating": {
    "list": [
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "description": "Paste a correlationId to trace a specific request"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Ticket Service — M3 Integrated Dashboard",
  "uid": "ticket-service-integrated",
  "version": 1
}