{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Error Rate — user-service (LogQL)",
      "description": "Count of ERROR-level log lines per minute. Spike = something is broken. [cite: 1617]",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({service=\"user-service\"} | json | level=\"ERROR\" [1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Authentication Events (LogQL)",
      "description": "REGISTERED and LOGGED_IN events over time — monitors auth traffic.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by(action) (count_over_time({service=\"user-service\"} | json | message=~\".*REGISTERED.*|.*LOGGED_IN.*\" [5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request rate (PromQL)",
      "description": "Requests per second to each user-service endpoint. [cite: 1646]",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"user-service\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP P99 latency (PromQL)",
      "description": "99th-percentile request duration per endpoint. [cite: 1648]",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m])))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Booking Service Feign Errors (LogQL)",
      "description": "Detects when event-service or booking-service is degraded. [cite: 1624]",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "count_over_time({service=\"user-service\"} | json | logger=~ \".*Client.*\" | level=\"WARN\" [1m])",
          "legendFormat": "feign-warn/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Heap Used (PromQL)",
      "description": "Heap usage monitor to detect memory leaks. [cite: 1650]",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"user-service\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 7,
      "title": "HikariCP — active DB connections (PromQL)",
      "description": "Active vs. idle JDBC connections to user-postgres. [cite: 1652]",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"user-service\"}",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 8,
      "title": "Request Log Volume by Path (LogQL)",
      "description": "Identifies high-traffic paths via logs.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by(requestPath) (count_over_time({service=\"user-service\"} | json | requestPath != \"\" [5m]))",
          "legendFormat": "{{requestPath}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Correlation ID Trace (LogQL — Explore)",
      "description": "Trace a single request across the cluster. [cite: 1619]",
      "type": "logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"user-service\"} | json | correlationId=\"$correlationId\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["eventticketing", "user-service", "m3"],
  "templating": {
    "list": [
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "description": "Paste a correlationId to trace a specific request"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "User Service — M3 Integrated Dashboard",
  "uid": "user-service-integrated",
  "version": 1
