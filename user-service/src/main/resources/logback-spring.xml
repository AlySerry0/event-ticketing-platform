<configuration>
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=eventticketing, service=${spring.application.name}</pattern>
            </label>
            <message>
                <pattern>
                    {
                    "timestamp": "%d{ISO8601}",
                    "level": "%level",
                    "service": "${spring.application.name}",
                    "thread": "%thread",
                    "correlationId": "%X{correlationId:-}",
                    "userId": "%X{userId:-}",
                    "message": "%msg"
                    }
                </pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="LOKI" />
    </root>
</configuration>